# --- Environment Variables ---
PORT=3000
NODE_ENV=development

CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Weather API Configuration ---
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_MAX_WIND_SPEED=10
WEATHER_ALLOW_PRECIPITATION=false
WEATHER_TIMEOUT_MS=5000
REQUEST_TIMEOUT_MS=5000

LOG_LEVEL=info

# --- Database Configuration ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=maintenance_owner
POSTGRES_PASSWORD=replace-with-local-owner-password
POSTGRES_APP_USER=maintenance_app
POSTGRES_APP_PASSWORD=replace-with-local-app-password
POSTGRES_DB=maintenance

# --- Pool Configuration ---
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000


DB_LOGGING=false
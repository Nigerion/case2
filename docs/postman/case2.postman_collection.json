{
  "info": {
    "name": "Case2 Maintenance API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "equipmentId", "value": "" },
    { "key": "requestId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('has status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Equipment",
      "item": [
        {
          "name": "Create equipment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Turbine A1\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"TRB-{{$randomInt}}\",\n  \"location\": { \"lat\": 55.75, \"lon\": 37.61 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2023-05-01T10:00:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/api/equipment"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.expect(json.data).to.have.property('id');",
                  "pm.collectionVariables.set('equipmentId', json.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List equipment",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment?page=1&limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(json).to.have.property('meta');",
                  "pm.expect(json.meta).to.have.property('total');"
                ]
              }
            }
          ]
        },
        {
          "name": "Get equipment 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment/00000000-0000-0000-0000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error format', () => {",
                  "  const e = pm.response.json().error;",
                  "  pm.expect(e).to.have.property('code');",
                  "  pm.expect(e).to.have.property('requestId');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Requests",
      "item": [
        {
          "name": "Create request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipmentId\": \"{{equipmentId}}\",\n  \"title\": \"Плановое ТО\",\n  \"priority\": \"high\"\n}"
            },
            "url": "{{baseUrl}}/api/requests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('requestId', json.data.id);",
                  "pm.expect(json.data.status).to.eql('new');"
                ]
              }
            }
          ]
        },
        {
          "name": "Create request for missing equipment (404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipmentId\": \"00000000-0000-0000-0000-000000000000\",\n  \"title\": \"Test request\",\n  \"priority\": \"low\"\n}"
            },
            "url": "{{baseUrl}}/api/requests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update status (valid)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"in_progress\"\n}" },
            "url": "{{baseUrl}}/api/requests/{{requestId}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status updated', () => pm.expect(pm.response.json().data.status).to.eql('in_progress'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update status (invalid transition, 409)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"new\"\n}" },
            "url": "{{baseUrl}}/api/requests/{{requestId}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete equipment with open request (409)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Validation errors",
      "item": [
        {
          "name": "Invalid body (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"x\"\n}" },
            "url": "{{baseUrl}}/api/equipment"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('has details', () => {",
                  "  const e = pm.response.json().error;",
                  "  pm.expect(e.code).to.eql('VALIDATION_ERROR');",
                  "  pm.expect(e.details).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Rate limit 429",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Запускать вручную несколько раз подряд или через Collection Runner",
                  "pm.test('eventually 429', () => {});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
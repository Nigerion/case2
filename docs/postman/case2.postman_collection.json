  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "equipmentId", "value": "" },
    { "key": "requestId", "value": "" },
    { "key": "disposableRequestId", "value": "" },
    { "key": "duplicateSerial", "value": "" },
    { "key": "siteId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "seededEquipmentId", "value": "b1111111-1111-1111-1111-111111111111" },
    { "key": "technician1Id", "value": "a1111111-1111-1111-1111-111111111111" },
    { "key": "technician2Id", "value": "a1111111-1111-1111-1111-111111111112" }

{
  "info": {
    "name": "Case2 Maintenance API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "equipmentId", "value": "" },
    { "key": "requestId", "value": "" },
    { "key": "duplicateSerial", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('has status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Equipment",
      "item": [
        {
          "name": "Create equipment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Turbine A1\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"TRB-{{$randomInt}}\",\n  \"location\": { \"lat\": 55.75, \"lon\": 37.61 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2023-05-01T10:00:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/api/equipment"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.expect(json.data).to.have.property('id');",
                  "pm.collectionVariables.set('equipmentId', json.data.id);",
                  "pm.collectionVariables.set('duplicateSerial', json.data.serialNumber);"
                ]
              }
            }
          ]
        },
        {
          "name": "List equipment",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment?page=1&limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(json).to.have.property('meta');",
                  "pm.expect(json.meta).to.have.property('total');"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate serial number (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate turbine\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"{{duplicateSerial}}\",\n  \"location\": { \"lat\": 55.75, \"lon\": 37.61 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2023-05-01T10:00:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/api/equipment"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 409', () => pm.response.to.have.status(409));",
              "pm.expect(pm.response.json().error.code).to.eql('CONFLICT');"
            ] }
          }]
        },
        {
          "name": "Get equipment 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment/00000000-0000-0000-0000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error format', () => {",
                  "  const e = pm.response.json().error;",
                  "  pm.expect(e).to.have.property('code');",
                  "  pm.expect(e).to.have.property('requestId');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get equipment",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('equipmentId'));"
            ] }
          }]
        },
        {
          "name": "Update equipment",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"maintenance\"\n}" },
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().data.status).to.eql('maintenance');"
            ] }
          }]
        },
        {
          "name": "Equipment requests",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}/requests"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().data).to.be.an('array');"
            ] }
          }]
        },
        {
          "name": "Equipment weather",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}/weather"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().data).to.have.property('outdoorWorkSuitable');"
            ] }
          }]
        }
      ]
    },
    {
      "name": "Requests",
      "item": [
        {
          "name": "Create request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipmentId\": \"{{equipmentId}}\",\n  \"title\": \"Плановое ТО\",\n  \"priority\": \"high\"\n}"
            },
            "url": "{{baseUrl}}/api/requests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('requestId', json.data.id);",
                  "pm.expect(json.data.status).to.eql('new');"
                ]
              }
            }
          ]
        },
        {
          "name": "Create request for missing equipment (404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipmentId\": \"00000000-0000-0000-0000-000000000000\",\n  \"title\": \"Test request\",\n  \"priority\": \"low\"\n}"
            },
            "url": "{{baseUrl}}/api/requests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "List requests",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/requests?page=1&limit=10&createdAtFrom=2020-01-01T00:00:00.000Z"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().data).to.be.an('array');",
              "pm.expect(pm.response.json()).to.have.property('meta');"
            ] }
          }]
        },
        {
          "name": "Get request",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/requests/{{requestId}}"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('requestId'));"
            ] }
          }]
        },
        {
          "name": "Update request",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Заменить фильтры\"\n}" },
            "url": "{{baseUrl}}/api/requests/{{requestId}}"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().data.description).to.eql('Заменить фильтры');"
            ] }
          }]
        },
        {
          "name": "Delete equipment with open request (409)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 409', () => pm.response.to.have.status(409));",
              "pm.expect(pm.response.json().error.code).to.eql('CONFLICT');"
            ] }
          }]
        },
        {
          "name": "Update status (valid)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"in_progress\"\n}" },
            "url": "{{baseUrl}}/api/requests/{{requestId}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status updated', () => pm.expect(pm.response.json().data.status).to.eql('in_progress'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete request in progress (409)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/requests/{{requestId}}"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 409', () => pm.response.to.have.status(409));",
              "pm.expect(pm.response.json().error.code).to.eql('CONFLICT');"
            ] }
          }]
        },
        {
          "name": "Complete request",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"done\"\n}" },
            "url": "{{baseUrl}}/api/requests/{{requestId}}/status"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().data.status).to.eql('done');"
            ] }
          }]
        },
        {
          "name": "Update status (invalid terminal transition, 409)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"new\"\n}" },
            "url": "{{baseUrl}}/api/requests/{{requestId}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update completed request (409)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Must not be edited\"\n}" },
            "url": "{{baseUrl}}/api/requests/{{requestId}}"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 409', () => pm.response.to.have.status(409));",
              "pm.expect(pm.response.json().error.code).to.eql('CONFLICT');"
            ] }
          }]
        },
        {
          "name": "Delete completed request",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/requests/{{requestId}}"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 204', () => pm.response.to.have.status(204));"
            ] }
          }]
        },
        {
          "name": "Delete equipment after closing request (204)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Validation errors",
      "item": [
        {
          "name": "Invalid body (422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"x\"\n}" },
            "url": "{{baseUrl}}/api/equipment"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));",
                  "pm.test('has details', () => {",
                  "  const e = pm.response.json().error;",
                  "  pm.expect(e.code).to.eql('VALIDATION_ERROR');",
                  "  pm.expect(e.details).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Rate limit",
      "item": [
        {
          "name": "First request (200)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.headers.has('ratelimit')).to.eql(true);"
            ] }
          }]
        },
        {
          "name": "Request over limit (429)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 429', () => pm.response.to.have.status(429));",
              "const error = pm.response.json().error;",
              "pm.expect(error.code).to.eql('RATE_LIMIT_EXCEEDED');",
              "pm.expect(error).to.have.property('requestId');",
              "pm.expect(pm.response.headers.has('ratelimit')).to.eql(true);"
            ] }
          }]
        }
      ]
    }
  ]
}
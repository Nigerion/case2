          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().data).to.be.an('array');"
            ] }
          }]
        },
        {
          "name": "Equipment weather",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}/weather"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().data).to.have.property('outdoorWorkSuitable');"
            ] }

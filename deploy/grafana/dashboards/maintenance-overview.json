{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "graphTooltip": 0,
  "id": null,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "sum by (route) (rate(http_requests_total[5m]))", "legendFormat": "{{route}}", "refId": "A" }],
      "title": "HTTP requests per second",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "100 * sum(rate(http_requests_total{status_code=~\"4..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)", "legendFormat": "4xx", "refId": "A" }],
      "title": "4xx response ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "targets": [{ "expr": "100 * sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)", "legendFormat": "5xx", "refId": "A" }],
      "title": "5xx response ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A" }],
      "title": "HTTP response time p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 8 },
      "id": 5,
      "targets": [{ "expr": "up{job=\"maintenance-api\"}", "legendFormat": "API", "refId": "A" }],
      "title": "API availability",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 8 },
      "id": 6,
      "targets": [{ "expr": "sum(rate(http_errors_total[5m]))", "legendFormat": "4xx + 5xx", "refId": "A" }],
      "title": "HTTP errors per second",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "id": 7,
      "targets": [{ "expr": "maintenance_requests_by_status_total", "legendFormat": "{{status}}", "refId": "A" }],
      "title": "Requests by status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "id": 8,
      "targets": [{ "expr": "maintenance_requests_by_priority_total", "legendFormat": "{{priority}}", "refId": "A" }],
      "title": "Requests by priority",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 16 },
      "id": 9,
      "targets": [{ "expr": "maintenance_request_close_duration_seconds_avg", "legendFormat": "average", "refId": "A" }],
      "title": "Average request closure time",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 16 },
      "id": 10,
      "targets": [{ "expr": "topk(10, equipment_open_requests_total)", "legendFormat": "{{equipment_name}}", "refId": "A" }],
      "title": "Open requests by equipment",
      "type": "barchart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 16 },
      "id": 11,
      "targets": [{ "expr": "maintenance_overdue_planned_requests_total", "legendFormat": "overdue", "refId": "A" }],
      "title": "Overdue planned work",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["maintenance", "operations"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Maintenance API overview",
  "uid": "maintenance-overview",
  "version": 1
}